5. Form Validation (JavaScript)
html
<!DOCTYPE html>
<html><body>
<h3>Registration Form</h3>
<form onsubmit="return validateForm()">
  First Name: <input type="text" id="fname"><br><br>
  Last Name: <input type="text" id="lname"><br><br>
  DOB: <input type="date" id="dob"><br><br>
  Phone: <input type="text" id="phone"><br><br>
  Email: <input type="text" id="email"><br><br>
  <button type="submit">Submit</button>
</form>
<p id="msg" style="color:red"></p>

<script>
function validateForm(){
  const fname = document.getElementById("fname").value.trim();
  const lname = document.getElementById("lname").value.trim();
  const dob = document.getElementById("dob").value;
  const phone = document.getElementById("phone").value.trim();
  const email = document.getElementById("email").value.trim();
  const msg = document.getElementById("msg");

  if(!fname || !lname || !dob || !phone || !email){
    msg.innerText = "All fields are required!"; return false;
  }
  if(!/^\S+@\S+\.\S+$/.test(email)){
    msg.innerText = "Invalid email format!"; return false;
  }
  if(!/^\d{10}$/.test(phone)){
    msg.innerText = "Phone number must be 10 digits!"; return false;
  }
  msg.style.color="green"; msg.innerText = "Form submitted successfully!";
  return false; // prevent actual submit for demo
}
</script>
</body></html>
6. JS Arrays & Objects — Product Cards
html
<!DOCTYPE html>
<html><head>
<style>
.card{display:inline-block;width:180px;margin:10px;padding:15px;border:1px solid #ccc;border-radius:8px;text-align:center;box-shadow:0 2px 5px rgba(0,0,0,0.1)}
</style></head>
<body>
<h3>Product List</h3>
<div id="products"></div>

<script>
const products = [
  { name: "Laptop", price: 55000, category: "Electronics" },
  { name: "Mobile Phone", price: 25000, category: "Electronics" },
  { name: "Shoes", price: 2000, category: "Fashion" },
  { name: "Book", price: 500, category: "Education" }
];

const container = document.getElementById("products");
products.forEach(p => {
  container.innerHTML += `
    <div class="card">
      <h4>${p.name}</h4>
      <p>Price: ₹${p.price}</p>
      <p>Category: ${p.category}</p>
    </div>`;
});
</script>
</body></html>
7. jQuery DOM Manipulation
html
<!DOCTYPE html>
<html><head>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<style>#box{width:100px;height:100px;background:tomato;margin-top:10px}</style>
</head><body>

<p id="para">This is a paragraph.</p>
<button id="toggleP">Hide/Show Paragraph</button><br><br>

<div id="box"></div>
<button id="fadeBtn">Fade Toggle Box</button>

<script>
$("#toggleP").click(function(){
  $("#para").toggle(); // hide/show
});

$("#fadeBtn").click(function(){
  $("#box").fadeToggle(); // fade in/out
});
</script>
</body></html>
